# Sanity project. Both are public values, safe to commit.
# Find them at sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Any random string. Paste the same value into the Sanity webhook that points
# at /api/revalidate, so publishing updates the live site.
SANITY_REVALIDATE_SECRET=
